# Copy to rc.env on the RC VM. Never commit rc.env with real keys.
# RC_NAME: omit — deploy.sh sets it from hostname (himorish-cslab-rc01, etc.)

RC_PROVISIONING_KEY='PASTE_FROM_SECURE_ACCESS_DASHBOARD'
RC_YES=1

# Optional: prefer one proxy; deploy probes wsa-1, wsa-2, proxy.esl if unset
# RC_HTTP_PROXY=http://proxy.esl.cisco.com:80
