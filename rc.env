# Deploy inputs for ./deploy.sh — edit and commit so the VM only needs:
#   git clone <this repo> && cd cisco-secure-access-rc-deploy && ./deploy.sh
#
# Placeholder values (REPLACE_ME / PASTE_...) are ignored and the script
# falls back to interactive prompts. Environment variables override this file.
#
# SECURITY: the provisioning key lets anyone enroll a connector into your
# Secure Access org. Keep this repo PRIVATE while a real key is committed,
# and regenerate the key in the dashboard if the repo is ever shared.

# Connector name: 1-40 chars (letters, digits, hyphen, underscore)
RC_NAME="himorish-cslab-rc01"

# Connector group → View Provisioning Key
RC_PROVISIONING_KEY="YjE0MmQ0OTEwNDc5NDVkYmE2ODEyODNiMDBmMTJiZjU6NTQxMzJmZjFkOTYyNDBmM2FiNDYyYjk5ODNhNmM4ODY="

# Optional: set to 1 to skip the "Proceed with launch?" confirmation
RC_YES=1

# CS lab proxy (faster than proxy.esl for large downloads e.g. cosign ~110MB)
RC_HTTP_PROXY="http://tyoidc5-dmz-wsa-1.cisco.com:80"
